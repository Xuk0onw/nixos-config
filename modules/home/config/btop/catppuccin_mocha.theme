# Catppuccin Mocha btop theme

# Main background
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color
theme[title]="#f38ba8"

# Highlight color
theme[hi_fg]="#a6e3a1"

# Selected process
theme[selected_bg]="#313244"
theme[selected_fg]="#a6e3a1"

# Inactive text
theme[inactive_fg]="#6c7086"

# Graph text
theme[graph_text]="#cdd6f4"

# Meter background
theme[meter_bg]="#45475a"

# Misc process colors
theme[proc_misc]="#f9e2af"

# Box colors
theme[cpu_box]="#f38ba8"
theme[mem_box]="#a6e3a1"
theme[net_box]="#f9e2af"
theme[proc_box]="#89b4fa"

# Divider lines
theme[div_line]="#45475a"

# Temperature graph
theme[temp_start]="#f38ba8"
theme[temp_mid]="#a6e3a1"
theme[temp_end]="#f9e2af"

# CPU graph
theme[cpu_start]="#89b4fa"
theme[cpu_mid]="#f38ba8"
theme[cpu_end]="#a6e3a1"

# Free memory
theme[free_start]="#f38ba8"
theme[free_mid]="#a6e3a1"
theme[free_end]="#f9e2af"

# Cached memory
theme[cached_start]="#89b4fa"
theme[cached_mid]="#f38ba8"
theme[cached_end]="#a6e3a1"

# Available memory
theme[available_start]="#a6e3a1"
theme[available_mid]="#f9e2af"
theme[available_end]="#89b4fa"

# Used memory
theme[used_start]="#f9e2af"
theme[used_mid]="#89b4fa"
theme[used_end]="#f38ba8"

# Download graph
theme[download_start]="#f9e2af"
theme[download_mid]="#a6e3a1"
theme[download_end]="#89b4fa"

# Upload graph
theme[upload_start]="#f38ba8"
theme[upload_mid]="#89b4fa"
theme[upload_end]="#a6e3a1"

# Process gradients
theme[process_start]="#89b4fa"
theme[process_mid]="#f38ba8"
theme[process_end]="#a6e3a1"
