{
  "$schema": "https://opencode.ai/config.json",

  // === Models ===
  "model": "openai/gpt-5.3-codex",
  "small_model": "openai/gpt-5.2",
  "autoupdate": "notify",

  // === Plugins ===
  // Disabled while testing local models (extra prompt/tool overhead).
  // Re-add "@dietrichgebert/ponytail" once local tool calling works.
  "plugin": ["@dietrichgebert/ponytail"],

  // === Providers ===
  // NOTE: limit.context only tells OpenCode the size. Ollama must ALSO be set
  // to the same num_ctx (OLLAMA_CONTEXT_LENGTH=32768), or it silently truncates.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (local)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 }
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B (local)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B (local)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },

  // === Formatters ===
  // Biome does not support .nix; removed.
  "formatter": {
    "biome": {
      "command": ["biome", "format", "--write", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".jsonc"]
    }
  },

  // === Permissions ===
  "permission": {
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow"
    },
    "external_directory": "allow",
    "bash": {
      "git push": "allow",
      "git push *": "allow",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny"
    }
  },

  // === MCP Servers ===
  // Heavy servers disabled: their tool schemas overwhelm small local models.
  // Set "enabled": true when using cloud models for web/Next.js work.
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": false
    }
  },

  // === Agent Overrides ===
  "agent": {
    "build": {
      "temperature": 0.2
    },
    "plan": {
      "model": "openai/gpt-5.3-codex",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "git status": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "bd *": "allow",
          "rg *": "allow",
          "tree *": "allow",
          "wc *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "pnpm exec tsc*": "allow",
          "pnpm run lint*": "allow",
          "pnpm test*": "allow",
          "*": "deny"
        }
      }
    },
    "security": {
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "temperature": 0.1,
      "permission": { "edit": "deny" },
      "description": "Security auditor - scans for vulnerabilities using Snyk tools (SCA, SAST, IaC, container). Read-only, reports findings without modification."
    },
    "test-writer": {
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "temperature": 0.2,
      "permission": {
        "edit": {
          "**/*.test.ts": "allow",
          "**/*.spec.ts": "allow",
          "**/*.test.tsx": "allow",
          "**/*.spec.tsx": "allow",
          "*": "deny"
        }
      },
      "description": "Test specialist - generates comprehensive unit, integration, and e2e tests. Can only write to test files."
    },
    "docs": {
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "temperature": 0.3,
      "permission": {
        "edit": {
          "**/*.md": "allow",
          "**/*.mdx": "allow",
          "*": "deny"
        }
      },
      "description": "Documentation writer - generates and updates markdown docs, READMEs, and guides. Can only write to .md/.mdx files."
    }
  }
}
